// -*- mode: jsonc -*-
{
    "reload_style_on_change": true,
    // "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    // "height": 30, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 16, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "custom/mako",
        "pulseaudio",
        "custom/weather",
        "custom/clock",
        "tray"
    ],
    "hyprland/window": {
        "format": "<span font='9' rise='-4444'>{}</span>"
    },
    "hyprland/workspaces": {
        "all-outputs": true,
        "on-click": "activate",
        "active-only": false,
        "format": "{name}",
        "sort-by-id": true,
        "disable-scroll": true,
        "warp-on-scroll": false,
        "persistent-workspaces": {
            "*": 10
        }
    },
    "tray": {
        // "icon-size": 21,
        "spacing": 10
    },
    "custom/clock": {
        "format": "{}",
        "exec": "date +\"📅 %a %d %b %Y | 🕓 %I:%M %p %Z\"",
        "interval": 1
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{icon}{volume}%",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [
                "  ",
                "  ",
                "  "
            ]
        },
        "on-click": "pavucontrol"
    },
    "custom/mako": {
        "format": "<span font='8'> {}</span>",
        "exec": "~/.config/waybar/scripts/mako.sh",
        "on-click": "~/.config/waybar/scripts/mako-dnd-toggle.sh",
        "restart-interval": 1
    },
    "custom/weather": {
        "exec": "cat $HOME/.weather",
        "return-type": "text",
        "format": "{}",
        "tooltip": true,
        "interval": 3600
    }
}
